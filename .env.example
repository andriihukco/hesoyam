# Copy to .env and fill in. .env is git-ignored. Never commit real values.

# --- Dashboard ---
HOST=127.0.0.1
PORT=8787
# Set if you expose the dashboard beyond localhost. UI asks for it once.
DASHBOARD_TOKEN=
DB_PATH=data/1mbot.sqlite

# --- Telegram (MTProto user session) ---
# Get api_id / api_hash at https://my.telegram.org. Use a dedicated account.
TG_API_ID=
TG_API_HASH=
# Run `npm run tg:login` once and paste the printed string here.
TG_SESSION=
# Comma-separated folder links, e.g. https://t.me/addlist/abc123
TG_FOLDER_LINKS=
# Optional extra channels (usernames or t.me links), comma-separated
TG_CHANNELS=
# Join channels from folder links that you are not in yet
TG_AUTO_JOIN=true

# --- X (ex-Twitter), read-only via twitterapi.io (paid, billed per tweet returned) ---
# Empty key = X source off.
X_API_KEY=
X_API_URL=https://api.twitterapi.io
# Accounts to follow (handles or profile links), comma-separated. No keyword search: too much spam.
X_HANDLES=
X_POLL_SEC=15

# --- Threads, read-only via Meta's official Threads API ---
# Long-lived user token (expires after 60 days). Reading other accounts needs the app permission
# threads_profile_discovery; keywords need threads_keyword_search. Without approval Meta returns almost nothing.
THREADS_ACCESS_TOKEN=
THREADS_API_URL=https://graph.threads.com/v1.0
# Accounts to follow (1,000 requests/day in total: 10 accounts = each polled about every 16 min)
THREADS_HANDLES=
# Keywords to search, recent posts (2,200 searches/day in total), e.g. pump
THREADS_KEYWORDS=

# --- Solana RPC ---
# name=url pairs, comma-separated. The dashboard lets you pick one.
RPC_ENDPOINTS=public=https://api.mainnet-beta.solana.com
# e.g. RPC_ENDPOINTS=public=https://api.mainnet-beta.solana.com,helius=https://mainnet.helius-rpc.com/?api-key=XXX

# --- Market data ---
PUMPPORTAL_WS_URL=wss://pumpportal.fun/api/data
# Trade subscriptions need a PumpPortal API key funded with >= 0.02 SOL.
# Empty = free fallback: bonding-curve account subscriptions over your RPC websocket.
PUMPPORTAL_API_KEY=
JUPITER_API_URL=https://lite-api.jup.ag/swap/v1
JUPITER_API_KEY=
RUGCHECK_API_URL=https://api.rugcheck.xyz/v1
DEXSCREENER_API_URL=https://api.dexscreener.com

# --- Live trading (Phase 7, not built yet). Keep false. ---
LIVE_TRADING_ENABLED=false
